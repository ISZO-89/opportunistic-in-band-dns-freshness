+
+template <size_t N>
+bool BytesEqual(const std::vector<uint8_t>& actual,
+                const std::array<uint8_t, N>& expected) {
+  return actual.size() == expected.size() &&
+         std::equal(actual.begin(), actual.end(), expected.begin());
+}
+
+bool BytesEqual(base::span<const uint8_t> actual,
+                const std::vector<uint8_t>& expected) {
+  return actual.size() == expected.size() &&
+         std::equal(actual.begin(), actual.end(), expected.begin());
+}
+
+const cbor::Value* FindIntegerKey(const cbor::Value::MapValue& map,
+                                  int64_t wanted_key) {
+  for (const auto& entry : map) {
+    if (entry.first.is_integer() && entry.first.GetInteger() == wanted_key) {
+      return &entry.second;
+    }
+  }
+  return nullptr;
+}
+
+std::optional<int64_t> GetInteger(const cbor::Value::MapValue& map,
+                                  int64_t key) {
+  const cbor::Value* value = FindIntegerKey(map, key);
+  if (!value || !value->is_integer()) {
+    return std::nullopt;
+  }
+  return value->GetInteger();
+}
+
+const std::vector<uint8_t>* GetBytes(const cbor::Value::MapValue& map,
+                                     int64_t key) {
+  const cbor::Value* value = FindIntegerKey(map, key);
+  if (!value || !value->is_bytestring()) {
+    return nullptr;
+  }
+  return &value->GetBytestring();
+}
+
+const cbor::Value::ArrayValue* GetArray(const cbor::Value::MapValue& map,
+                                        int64_t key) {
+  const cbor::Value* value = FindIntegerKey(map, key);
+  if (!value || !value->is_array()) {
+    return nullptr;
+  }
+  return &value->GetArray();
+}
+
+bool IsDeterministicCbor(base::span<const uint8_t> original,
+                         const cbor::Value& parsed) {
+  auto encoded = cbor::Writer::Write(parsed);
+  return encoded.has_value() && BytesEqual(original, *encoded);
+}
+
+// ---------------------------------------------------------------------------
+// Minimal deterministic-CBOR encoder used independently to construct:
+//   1. COSE Sig_structure
+//   2. canonical DNS state for digest recomputation.
+//
+// This avoids trusting the signed to_digest without independently computing
+// the candidate state.
+// ---------------------------------------------------------------------------
+
+void AppendTypeAndLength(std::vector<uint8_t>* out,
+                         uint8_t major_type,
+                         uint64_t value) {
+  const uint8_t major = static_cast<uint8_t>(major_type << 5);
+
+  if (value < 24) {
+    out->push_back(static_cast<uint8_t>(major | value));
+    return;
+  }
+
+  if (value <= 0xff) {
+    out->push_back(static_cast<uint8_t>(major | 24));
+    out->push_back(static_cast<uint8_t>(value));
+    return;
+  }
+
+  if (value <= 0xffff) {
+    out->push_back(static_cast<uint8_t>(major | 25));
+    out->push_back(static_cast<uint8_t>((value >> 8) & 0xff));
+    out->push_back(static_cast<uint8_t>(value & 0xff));
+    return;
+  }
+
+  if (value <= 0xffffffffULL) {
+    out->push_back(static_cast<uint8_t>(major | 26));
+    for (int shift = 24; shift >= 0; shift -= 8) {
+      out->push_back(static_cast<uint8_t>((value >> shift) & 0xff));
+    }
+    return;
+  }
+
+  out->push_back(static_cast<uint8_t>(major | 27));
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    out->push_back(static_cast<uint8_t>((value >> shift) & 0xff));
+  }
+}
+
+void AppendUnsigned(std::vector<uint8_t>* out, uint64_t value) {
+  AppendTypeAndLength(out, 0, value);
+}
+
+void AppendBytes(std::vector<uint8_t>* out, base::span<const uint8_t> value) {
+  AppendTypeAndLength(out, 2, value.size());
+  out->insert(out->end(), value.begin(), value.end());
+}
+
+void AppendText(std::vector<uint8_t>* out, std::string_view value) {
+  AppendTypeAndLength(out, 3, value.size());
+  out->insert(out->end(), value.begin(), value.end());
+}
+
+void AppendArrayHeader(std::vector<uint8_t>* out, uint64_t count) {
+  AppendTypeAndLength(out, 4, count);
+}
+
+void AppendMapHeader(std::vector<uint8_t>* out, uint64_t count) {
+  AppendTypeAndLength(out, 5, count);
+}
+
+std::array<uint8_t, SHA256_DIGEST_LENGTH> Sha256(
+    base::span<const uint8_t> bytes) {
+  std::array<uint8_t, SHA256_DIGEST_LENGTH> digest{};
+  SHA256(bytes.data(), bytes.size(), digest.data());
+  return digest;
+}
+
+std::vector<uint8_t> BuildSigStructure(
+    const std::vector<uint8_t>& protected_headers,
+    const std::vector<uint8_t>& payload) {
+  std::vector<uint8_t> out;
+
+  AppendArrayHeader(&out, 4);
+  AppendText(&out, "Signature1");
+  AppendBytes(&out, AsSpan(protected_headers));
+  AppendBytes(&out, base::span<const uint8_t>());
+  AppendBytes(&out, AsSpan(payload));
+
+  return out;
+}
+
+// Canonical scope state:
+//
+// {
+//   1: service_id,
+//   2: scope_id,
+//   3: [
+//        [
+//          owner_wire,
+//          1,
+//          [
+//            [ IN, A, ttl, [ IPv4-rdata ] ]
+//          ]
+//        ]
+//      ]
+// }
+std::vector<uint8_t> BuildCanonicalSingleAState(
+    uint64_t root_epoch,
+    const ServiceId& service_id,
+    const ScopeId& scope_id,
+    base::span<const uint8_t> ipv4_rdata,
+    uint64_t ttl) {
+  std::vector<uint8_t> out;
+
+  // Full v0.1 state identity for this single-A lab scope:
+  //
+  // {
+  //   0: protocol_version,
+  //   1: root_epoch,
+  //   2: service_id,
+  //   3: scope_id,
+  //   4: [
+  //        [
+  //          owner_wire,
+  //          1,  // owner exists
+  //          [
+  //            [ IN, A, ttl, [ IPv4-rdata ] ]
+  //          ]
+  //        ]
+  //      ]
+  // }
+  AppendMapHeader(&out, 5);
+
+  AppendUnsigned(&out, 0);
+  AppendUnsigned(&out, kProtocolVersion);
+
+  AppendUnsigned(&out, 1);
+  AppendUnsigned(&out, root_epoch);
+
+  AppendUnsigned(&out, 2);
+  AppendBytes(&out, base::span<const uint8_t>(service_id));
+
+  AppendUnsigned(&out, 3);
+  AppendBytes(&out, base::span<const uint8_t>(scope_id));
+
+  AppendUnsigned(&out, 4);
+  AppendArrayHeader(&out, 1);
+
+  AppendArrayHeader(&out, 3);
+  AppendBytes(&out, base::span<const uint8_t>(kOwnerWire));
+  AppendUnsigned(&out, 1);
+
+  AppendArrayHeader(&out, 1);
+  AppendArrayHeader(&out, 4);
+
+  AppendUnsigned(&out, kDnsClassIn);
+  AppendUnsigned(&out, kDnsTypeA);
+  AppendUnsigned(&out, ttl);
+
+  AppendArrayHeader(&out, 1);
+  AppendBytes(&out, ipv4_rdata);
+
+  return out;
+}
+
+bool ParseCanonicalSingleAState(
+    base::span<const uint8_t> raw,
+    uint64_t expected_root_epoch,
+    const ServiceId& expected_service_id,
+    const ScopeId& expected_scope_id,
+    uint32_t* ttl_out,
+    std::vector<uint8_t>* rdata_out) {
+  if (!ttl_out || !rdata_out) {
+    return false;
+  }
+
+  std::optional<cbor::Value> parsed = cbor::Reader::Read(raw);
+
+  if (!parsed.has_value() || !parsed->is_map() ||
+      !IsDeterministicCbor(raw, *parsed)) {
+    return false;
+  }
+
+  const auto& map = parsed->GetMap();
+
+  if (map.size() != 5) {
+    return false;
+  }
+
+  const auto version = GetInteger(map, 0);
+  const auto root_epoch = GetInteger(map, 1);
+  const auto* service_id = GetBytes(map, 2);
+  const auto* scope_id = GetBytes(map, 3);
+  const auto* nodes = GetArray(map, 4);
+
+  if (!version.has_value() || *version != kProtocolVersion ||
+      !root_epoch.has_value() || *root_epoch < 0 ||
+      static_cast<uint64_t>(*root_epoch) != expected_root_epoch ||
+      !service_id || !BytesEqual(*service_id, expected_service_id) ||
+      !scope_id || !BytesEqual(*scope_id, expected_scope_id) ||
+      !nodes || nodes->size() != 1) {
+    return false;
+  }
+
+  const cbor::Value& node_value = (*nodes)[0];
+
+  if (!node_value.is_array()) {
+    return false;
+  }
+
+  const auto& node = node_value.GetArray();
+
+  if (node.size() != 3 ||
+      !node[0].is_bytestring() ||
+      !node[1].is_integer() ||
+      !node[2].is_array() ||
+      !BytesEqual(node[0].GetBytestring(), kOwnerWire) ||
+      node[1].GetInteger() != 1) {
+    return false;
+  }
+
+  const auto& rrsets = node[2].GetArray();
+
+  if (rrsets.size() != 1 || !rrsets[0].is_array()) {
+    return false;
+  }
+
+  const auto& rr = rrsets[0].GetArray();
+
+  if (rr.size() != 4 ||
+      !rr[0].is_integer() ||
+      !rr[1].is_integer() ||
+      !rr[2].is_integer() ||
+      !rr[3].is_array() ||
+      rr[0].GetInteger() != kDnsClassIn ||
+      rr[1].GetInteger() != kDnsTypeA ||
+      rr[2].GetInteger() < 0 ||
+      rr[2].GetInteger() > 0xffffffffLL) {
+    return false;
+  }
+
+  const auto& rdatas = rr[3].GetArray();
+
+  if (rdatas.size() != 1 ||
+      !rdatas[0].is_bytestring() ||
+      rdatas[0].GetBytestring().size() != 4) {
+    return false;
+  }
+
+  *ttl_out = static_cast<uint32_t>(rr[2].GetInteger());
+  *rdata_out = rdatas[0].GetBytestring();
+  return true;
+}
+
+
+bool DigestMatches(const std::array<uint8_t, SHA256_DIGEST_LENGTH>& actual,
+                   const std::vector<uint8_t>& expected) {
+  return expected.size() == actual.size() &&
+         std::equal(actual.begin(), actual.end(), expected.begin());
+}
+
+}  // namespace
+
+bool ProcessFreshnessResponse(
+    net::URLRequest* request,
+    const net::HttpResponseHeaders* response_headers,
+    const net::IPEndPoint& remote_endpoint,
+    FreshnessStateStore* store) {
+  if (!request || !response_headers || !store) {
+    return false;
+  }
+
+  if (!request->url().SchemeIs("https") ||
+      request->url().host() != "a.service.test") {
+    return false;
+  }
+
+  std::optional<std::string> header =
+      response_headers->GetNormalizedHeader("dns-freshness-object");
+
+  // No Freshness object is normal opportunistic degradation.
+  if (!header.has_value()) {
+    return false;
+  }
+
+  if (header->size() > kMaxStructuredFieldBytes) {
+    return Reject("SF_OVERSIZE");
+  }
+
+  auto sf_item = net::structured_headers::ParseItem(*header);
+
+  if (!sf_item.has_value() ||
+      !sf_item->params.empty() ||
+      !sf_item->item.is_byte_sequence()) {
+    return Reject("SF_PARSE");
+  }
+
+  const std::string& cose_string = sf_item->item.GetString();
+
+  if (cose_string.empty() ||
+      cose_string.size() > kMaxCoseBytes) {
+    return Reject("COSE_SIZE");
+  }
+
+  const auto& nak =
+      request->isolation_info().network_anonymization_key();
+
+  const base::Time now = base::Time::Now();
+
+  const ServiceState* service =
+      store->FindService(request->url().host(), nak);
+
+  // Incoming objects derive authority only from DNSSEC-installed
+  // service state. The old hardcoded lab public key is no longer
+  // a trust source.
+  if (!service ||
+      !service->has_root_public_key ||
+      !service->IsRootAuthorizedAt(now)) {
+    return Reject("NO_AUTHORIZED_DNSSEC_ROOT");
+  }
+
+  base::span<const uint8_t> cose_raw = AsSpan(cose_string);
+
+  if (cose_raw[0] != 0xd2) {
+    return Reject("COSE_TAG18");
+  }
+
+  base::span<const uint8_t> cose_body = cose_raw.subspan<1>();
+
+  std::optional<cbor::Value> cose =
+      cbor::Reader::Read(cose_body);
+
+  if (!cose.has_value() || !cose->is_array()) {
+    return Reject("COSE_CBOR");
+  }
+
+  if (!IsDeterministicCbor(cose_body, *cose)) {
+    return Reject("COSE_NONDETERMINISTIC");
+  }
+
+  const auto& cose_array = cose->GetArray();
+
+  if (cose_array.size() != 4 ||
+      !cose_array[0].is_bytestring() ||
+      !cose_array[1].is_map() ||
+      !cose_array[2].is_bytestring() ||
+      !cose_array[3].is_bytestring()) {
+    return Reject("COSE_SHAPE");
+  }
+
+  if (!cose_array[1].GetMap().empty()) {
+    return Reject("COSE_UNPROTECTED");
+  }
+
+  const std::vector<uint8_t>& protected_bytes =
+      cose_array[0].GetBytestring();
+  const std::vector<uint8_t>& payload_bytes =
+      cose_array[2].GetBytestring();
+  const std::vector<uint8_t>& signature =
+      cose_array[3].GetBytestring();
+
+  if (signature.size() != ED25519_SIGNATURE_LEN) {
+    return Reject("SIGNATURE_LENGTH");
+  }
+
+  std::optional<cbor::Value> protected_value =
+      cbor::Reader::Read(AsSpan(protected_bytes));
+
+  if (!protected_value.has_value() ||
+      !protected_value->is_map()) {
+    return Reject("PROTECTED_CBOR");
+  }
+
+  if (!IsDeterministicCbor(
+          AsSpan(protected_bytes), *protected_value)) {
+    return Reject("PROTECTED_NONDETERMINISTIC");
+  }
+
+  const auto& protected_map = protected_value->GetMap();
+
+  const auto alg = GetInteger(protected_map, 1);
+  const std::vector<uint8_t>* protected_kid =
+      GetBytes(protected_map, 4);
+
+  if (!alg.has_value() || *alg != -19) {
+    return Reject("COSE_ALG");
+  }
+
+  // Experimental lab KID remains stable, but the verification key
+  // itself now comes from DNSSEC-authenticated discovery state.
+  if (!protected_kid ||
+      !BytesEqual(*protected_kid, kKeyId)) {
+    return Reject("COSE_KID");
+  }
+
+  std::vector<uint8_t> sig_structure =
+      BuildSigStructure(protected_bytes, payload_bytes);
+
+  if (ED25519_verify(
+          sig_structure.data(),
+          sig_structure.size(),
+          signature.data(),
+          service->root_public_key.data()) != 1) {
+    return Reject("ED25519_DNSSEC_ROOT");
+  }
+
+  LOG(ERROR)
+      << "DNS_FRESHNESS_NATIVE COSE_SIGNATURE=PASS"
+      << " TRUST=DNSSEC_ROOT";
+
+  std::optional<cbor::Value> payload =
+      cbor::Reader::Read(AsSpan(payload_bytes));
+
+  if (!payload.has_value() || !payload->is_map()) {
+    return Reject("PAYLOAD_CBOR");
+  }
+
+  if (!IsDeterministicCbor(
+          AsSpan(payload_bytes), *payload)) {
+    return Reject("PAYLOAD_NONDETERMINISTIC");
+  }
+
+  const auto& map = payload->GetMap();
+
+  const auto version = GetInteger(map, 0);
+  const auto object_type = GetInteger(map, 1);
+  const auto root_epoch = GetInteger(map, 2);
+  const auto* service_id = GetBytes(map, 3);
+  const auto* scope_id_bytes = GetBytes(map, 4);
+  const auto issued_at = GetInteger(map, 7);
+  const auto valid_until = GetInteger(map, 8);
+  const auto* payload_kid = GetBytes(map, 9);
+
+  if (!version.has_value() ||
+      *version != kProtocolVersion ||
+      !object_type.has_value() ||
+      !root_epoch.has_value() ||
+      *root_epoch < 0 ||
+      !service_id ||
+      !scope_id_bytes ||
+      scope_id_bytes->size() != ScopeId{}.size() ||
+      !issued_at.has_value() ||
+      !valid_until.has_value() ||
+      *issued_at <= 0 ||
+      *valid_until <= *issued_at ||
+      !payload_kid ||
+      !BytesEqual(*payload_kid, kKeyId) ||
+      *payload_kid != *protected_kid) {
+    return Reject("COMMON_FIELDS");
+  }
+
+  if (!BytesEqual(*service_id, service->service_id)) {
+    return Reject("SERVICE_ID");
+  }
+
+  if (static_cast<uint64_t>(*root_epoch) !=
+      service->root_epoch) {
+    return Reject("ROOT_EPOCH_BINDING");
+  }
+
+  const base::Time issued_time =
+      base::Time::UnixEpoch() + base::Seconds(*issued_at);
+  const base::Time valid_time =
+      base::Time::UnixEpoch() + base::Seconds(*valid_until);
+
+  if (now < issued_time) {
+    return Reject("ISSUED_IN_FUTURE");
+  }
+
+  if (now >= valid_time) {
+    return Reject("OBJECT_EXPIRED");
+  }
+
+  if (valid_time > service->root_not_after) {
+    return Reject("LEASE_EXCEEDS_ROOT");
+  }
+
+  ScopeId scope_id{};
+  std::copy(
+      scope_id_bytes->begin(),
+      scope_id_bytes->end(),
+      scope_id.begin());
+
+  // ============================================================
+  // SNAPSHOT: first/re-admission from DNS_BOOTSTRAP.
+  //
+  // Experimental additional compact fields:
+  //   15 admission_context
+  //   16 members descriptors
+  //   17 complete canonical scope-state CBOR bytes
+  // ============================================================
+  if (*object_type == kSnapshotObjectType) {
+    if (map.size() != 13) {
+      return Reject("SNAPSHOT_MAP_SIZE");
+    }
+
+    if (!service->scopes.empty()) {
+      return Reject("SNAPSHOT_WHILE_ACTIVE");
+    }
+
+    const auto generation = GetInteger(map, 5);
+    const auto* state_digest = GetBytes(map, 6);
+    const auto* admission_context = GetBytes(map, 15);
+    const auto* members = GetArray(map, 16);
+    const auto* complete_state = GetBytes(map, 17);
+
+    if (!generation.has_value() ||
+        *generation < 0 ||
+        !state_digest ||
+        state_digest->size() != SHA256_DIGEST_LENGTH ||
+        !admission_context ||
+        *admission_context != service->admission_context ||
+        !members ||
+        members->size() != 1 ||
+        !complete_state ||
+        complete_state->empty()) {
+      return Reject("SNAPSHOT_FIELDS");
+    }
+
+    // Explicit member descriptor must match the complete state.
+    const cbor::Value& member_desc_value = (*members)[0];
+
+    if (!member_desc_value.is_array()) {
+      return Reject("SNAPSHOT_MEMBER_DESCRIPTOR");
+    }
+
+    const auto& member_desc =
+        member_desc_value.GetArray();
+
+    if (member_desc.size() != 3 ||
+        !member_desc[0].is_bytestring() ||
+        !member_desc[1].is_integer() ||
+        !member_desc[2].is_integer() ||
+        !BytesEqual(
+            member_desc[0].GetBytestring(), kOwnerWire) ||
+        member_desc[1].GetInteger() != kDnsClassIn ||
+        member_desc[2].GetInteger() != kDnsTypeA) {
+      return Reject("SNAPSHOT_MEMBER_DESCRIPTOR");
+    }
+
+    uint32_t ttl = 0;
+    std::vector<uint8_t> rdata;
+
+    if (!ParseCanonicalSingleAState(
+            AsSpan(*complete_state),
+            service->root_epoch,
+            service->service_id,
+            scope_id,
+            &ttl,
+            &rdata)) {
+      return Reject("SNAPSHOT_COMPLETE_STATE");
+    }
+
+    std::vector<uint8_t> rebuilt_state =
+        BuildCanonicalSingleAState(
+            service->root_epoch,
+            service->service_id,
+            scope_id,
+            AsSpan(rdata),
+            ttl);
+
+    if (!BytesEqual(
+            AsSpan(*complete_state), rebuilt_state)) {
+      return Reject("SNAPSHOT_STATE_REENCODE");
+    }
+
+    const auto calculated_digest =
+        Sha256(AsSpan(rebuilt_state));
+
+    if (!DigestMatches(
+            calculated_digest, *state_digest)) {
+      return Reject("SNAPSHOT_DIGEST");
+    }
+
+    // In the initial single-endpoint lab admission, the signed
+    // complete state must describe the path Chromium actually used.
+    if (!remote_endpoint.address().IsIPv4() ||
+        !BytesEqual(
+            remote_endpoint.address().bytes().span(),
+            rdata)) {
+      return Reject("SNAPSHOT_PATH_MISMATCH");
+    }
+
+    ScopeState scope;
+    scope.scope_id = scope_id;
+    scope.generation =
+        static_cast<uint64_t>(*generation);
+    std::copy(
+        state_digest->begin(),
+        state_digest->end(),
+        scope.state_digest.begin());
+    scope.issued_at = issued_time;
+    scope.valid_until = valid_time;
+
+    MemberState member;
+    member.owner_wire.assign(
+        kOwnerWire.begin(), kOwnerWire.end());
+    member.rrtype =
+        static_cast<uint16_t>(kDnsTypeA);
+    member.rrclass =
+        static_cast<uint16_t>(kDnsClassIn);
+    member.kind = MemberStateKind::kPositive;
+    member.ttl = ttl;
+    member.rdata.push_back(rdata);
+    scope.members.push_back(std::move(member));
+
+    // Re-check authorization immediately before state mutation.
+    if (!service->IsRootAuthorizedAt(
+            base::Time::Now())) {
+      return Reject("ROOT_EXPIRED_BEFORE_COMMIT");
+    }
+
+    if (!store->CommitAuthorizedScope(
+            request->url().host(),
+            nak,
+            std::move(scope),
+            now,
+            base::TimeTicks::Now())) {
+      return Reject("SNAPSHOT_STATE_COMMIT");
+    }
+
+    LOG(ERROR)
+        << "DNS_FRESHNESS_NATIVE SNAPSHOT_ADMITTED=PASS"
+        << " GEN=" << *generation
+        << " ENDPOINT="
+        << remote_endpoint.address().ToString()
+        << " ROOT_EPOCH=" << *root_epoch;
+
+    return true;
+  }
+
+  // ============================================================
+  // DELTA: exact stateful ancestry against ACTIVE_AUTHORIZED.
+  // ============================================================
+  if (*object_type == kDeltaObjectType) {
+    if (map.size() != 13) {
+      return Reject("DELTA_MAP_SIZE");
+    }
+
+    const auto from_generation =
+        GetInteger(map, 10);
+    const auto* from_digest =
+        GetBytes(map, 11);
+    const auto to_generation =
+        GetInteger(map, 12);
+    const auto* to_digest =
+        GetBytes(map, 13);
+    const auto* operations =
+        GetArray(map, 14);
+
+    if (!from_generation.has_value() ||
+        *from_generation < 0 ||
+        !to_generation.has_value() ||
+        *to_generation < 0 ||
+        *to_generation <= *from_generation ||
+        !from_digest ||
+        from_digest->size() != SHA256_DIGEST_LENGTH ||
+        !to_digest ||
+        to_digest->size() != SHA256_DIGEST_LENGTH ||
+        !operations ||
+        operations->size() != 1) {
+      return Reject("DELTA_FIELDS");
+    }
+
+    const ScopeState* current =
+        store->FindScope(*service, scope_id);
+
+    if (!current ||
+        !current->IsAuthorizedAt(now)) {
+      return Reject("NO_ACTIVE_SCOPE");
+    }
+
+    const uint64_t incoming_from =
+        static_cast<uint64_t>(*from_generation);
+
+    if (incoming_from < current->generation) {
+      LOG(ERROR)
+          << "DNS_FRESHNESS_NATIVE STALE_DELTA=IGNORE"
+          << " LOCAL_GEN=" << current->generation
+          << " FROM_GEN=" << incoming_from;
+      return false;
+    }
+
+    if (incoming_from > current->generation) {
+      store->MarkRecoveryRequired(
+          request->url().host(), nak, scope_id);
+      return Reject("GENERATION_GAP");
+    }
+
+    if (!BytesEqual(
+            *from_digest, current->state_digest)) {
+      store->MarkRecoveryRequired(
+          request->url().host(), nak, scope_id);
+      return Reject("FROM_DIGEST_FORK");
+    }
+
+    LOG(ERROR)
+        << "DNS_FRESHNESS_NATIVE "
+           "FROM_GENERATION_DIGEST=PASS"
+        << " GEN=" << current->generation;
+
+    const cbor::Value& op_value =
+        (*operations)[0];
+
+    if (!op_value.is_array()) {
+      return Reject("OPERATION_SHAPE");
+    }
+
+    const auto& op = op_value.GetArray();
+
+    if (op.size() != 6 ||
+        !op[0].is_integer() ||
+        !op[1].is_bytestring() ||
+        !op[2].is_integer() ||
+        !op[3].is_integer() ||
+        !op[4].is_integer() ||
+        !op[5].is_array()) {
+      return Reject("REPLACE_SHAPE");
+    }
+
+    if (op[0].GetInteger() != kReplaceRrset ||
+        !BytesEqual(op[1].GetBytestring(), kOwnerWire) ||
+        op[2].GetInteger() != kDnsClassIn ||
+        op[3].GetInteger() != kDnsTypeA ||
+        op[4].GetInteger() < 0 ||
+        op[4].GetInteger() > 0xffffffffLL) {
+      return Reject("REPLACE_FIELDS");
+    }
+
+    const auto& rdata_values =
+        op[5].GetArray();
+
+    if (rdata_values.size() != 1 ||
+        !rdata_values[0].is_bytestring() ||
+        rdata_values[0].GetBytestring().size() != 4) {
+      return Reject("REPLACE_RDATA");
+    }
+
+    if (current->members.size() != 1 ||
+        current->members[0].kind !=
+            MemberStateKind::kPositive ||
+        current->members[0].rrclass !=
+            kDnsClassIn ||
+        current->members[0].rrtype !=
+            kDnsTypeA ||
+        current->members[0].owner_wire !=
+            std::vector<uint8_t>(
+                kOwnerWire.begin(), kOwnerWire.end()) ||
+        current->members[0].rdata.size() != 1 ||
+        current->members[0].rdata[0].size() != 4) {
+      return Reject("LOCAL_SCOPE_SHAPE");
+    }
+
+    const std::vector<uint8_t>& new_rdata =
+        rdata_values[0].GetBytestring();
+
+    ScopeState candidate = *current;
+    candidate.generation =
+        static_cast<uint64_t>(*to_generation);
+    candidate.issued_at = issued_time;
+    candidate.valid_until = valid_time;
+    candidate.members[0].ttl =
+        static_cast<uint32_t>(op[4].GetInteger());
+    candidate.members[0].rdata.clear();
+    candidate.members[0].rdata.push_back(new_rdata);
+
+    std::vector<uint8_t> candidate_raw =
+        BuildCanonicalSingleAState(
+            service->root_epoch,
+            service->service_id,
+            scope_id,
+            AsSpan(new_rdata),
+            candidate.members[0].ttl);
+
+    const auto calculated_to_digest =
+        Sha256(AsSpan(candidate_raw));
+
+    if (!DigestMatches(
+            calculated_to_digest, *to_digest)) {
+      return Reject("TO_DIGEST");
+    }
+
+    std::copy(
+        to_digest->begin(),
+        to_digest->end(),
+        candidate.state_digest.begin());
+
+    LOG(ERROR)
+        << "DNS_FRESHNESS_NATIVE REPLACE_RRSET=PASS";
+    LOG(ERROR)
+        << "DNS_FRESHNESS_NATIVE TO_DIGEST=PASS";
+
+    net::IPAddress new_address(
+        AsSpan(new_rdata));
+
+    if (!new_address.IsValid() ||
+        !new_address.IsIPv4()) {
+      return Reject("NEW_ADDRESS");
+    }
+
+    const std::vector<uint8_t> old_rdata =
+        current->members[0].rdata[0];
+    const uint32_t old_ttl =
+        current->members[0].ttl;
+
+    net::IPAddress old_address(
+        AsSpan(old_rdata));
+
+    const net::URLRequestContext* context =
+        request->context();
+
+    if (!context || !context->host_resolver()) {
+      return Reject("NO_HOST_RESOLVER");
+    }
+
+    net::HostCache* cache =
+        context->host_resolver()->GetHostCache();
+
+    if (!cache) {
+      return Reject("NO_HOST_CACHE");
+    }
+
+    // Last authorization check before any mutation.
+    if (!service->IsRootAuthorizedAt(
+            base::Time::Now())) {
+      return Reject("ROOT_EXPIRED_BEFORE_COMMIT");
+    }
+
+    // Stage 1: resolver cache.
+    if (!cache->UpdateActiveAddressForFreshness(
+            request->url().host(),
+            nak,
+            new_address,
+            base::TimeTicks::Now(),
+            base::Seconds(
+                candidate.members[0].ttl))) {
+      return Reject("NO_ACTIVE_CACHE_ENTRY");
+    }
+
+    // Stage 2: authoritative Freshness scope state.
+    //
+    // If this unexpectedly fails after the already-validated
+    // HostCache mutation, restore the old address immediately.
+    if (!store->CommitAuthorizedScope(
+            request->url().host(),
+            nak,
+            std::move(candidate),
+            now,
+            base::TimeTicks::Now())) {
+      const bool rolled_back =
+          cache->UpdateActiveAddressForFreshness(
+              request->url().host(),
+              nak,
+              old_address,
+              base::TimeTicks::Now(),
+              base::Seconds(old_ttl));
+
+      LOG(ERROR)
+          << "DNS_FRESHNESS_NATIVE "
+             "HOSTCACHE_ROLLBACK="
+          << (rolled_back ? "PASS" : "FAIL");
+
+      return Reject("SCOPE_COMMIT");
+    }
+
+    LOG(ERROR)
+        << "DNS_FRESHNESS_NATIVE COMMIT=PASS"
+        << " GEN=" << *to_generation
+        << " ENDPOINT=" << new_address.ToString()
+        << " ROOT_EPOCH=" << *root_epoch;
+
+    return true;
+  }
+
+  return Reject("UNSUPPORTED_OBJECT_TYPE");
+}
+
+bool ProcessDnssecFreshnessDiscovery(
+    const std::string& hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    const std::vector<uint8_t>& discovery,
+    FreshnessStateStore* store) {
+  auto reject = [](const char* reason) {
+    LOG(ERROR) << "DNS_FRESHNESS_NATIVE DISCOVERY_REJECT=" << reason;
+    return false;
+  };
+
+  // Experimental Native-v0.1 discovery labels.
+  constexpr int64_t kDiscoveryVersion = 0;
+  constexpr int64_t kDiscoveryServiceId = 1;
+  constexpr int64_t kDiscoveryAdmissionContext = 2;
+  constexpr int64_t kDiscoveryRootEpoch = 3;
+  constexpr int64_t kDiscoveryRootPublicKey = 4;
+  constexpr int64_t kDiscoveryRootNotAfter = 5;
+  constexpr int64_t kDiscoveryCapabilityFlags = 6;
+
+  constexpr size_t kMaxDiscoveryBytes = 4096;
+  constexpr int64_t kMaxUnixSeconds = 253402300799LL;
+
+  if (!store || hostname.empty() || discovery.empty() ||
+      discovery.size() > kMaxDiscoveryBytes) {
+    return reject("INPUT");
+  }
+
+  std::optional<cbor::Value> parsed =
+      cbor::Reader::Read(AsSpan(discovery));
+  if (!parsed.has_value() || !parsed->is_map()) {
+    return reject("CBOR");
+  }
+
+  if (!IsDeterministicCbor(AsSpan(discovery), *parsed)) {
+    return reject("NONDETERMINISTIC");
+  }
+
+  const auto& map = parsed->GetMap();
+  if (map.size() != 7) {
+    return reject("MAP_SIZE");
+  }
+
+  const auto version = GetInteger(map, kDiscoveryVersion);
+  const auto* service_id_bytes = GetBytes(map, kDiscoveryServiceId);
+  const auto* admission_context = GetBytes(map, kDiscoveryAdmissionContext);
+  const auto root_epoch = GetInteger(map, kDiscoveryRootEpoch);
+  const auto* root_public_key_bytes =
+      GetBytes(map, kDiscoveryRootPublicKey);
+  const auto root_not_after = GetInteger(map, kDiscoveryRootNotAfter);
+  const auto capability_flags =
+      GetInteger(map, kDiscoveryCapabilityFlags);
+
+  if (!version.has_value() || *version != kProtocolVersion) {
+    return reject("VERSION");
+  }
+
+  if (!service_id_bytes ||
+      service_id_bytes->size() != ServiceId{}.size()) {
+    return reject("SERVICE_ID");
+  }
+
+  if (!admission_context || admission_context->empty() ||
+      admission_context->size() > kMaxAdmissionContextBytes) {
+    return reject("ADMISSION_CONTEXT");
+  }
+
+  if (!root_epoch.has_value() || *root_epoch < 0) {
+    return reject("ROOT_EPOCH");
+  }
+
+  if (!root_public_key_bytes ||
+      root_public_key_bytes->size() != Ed25519PublicKey{}.size()) {
+    return reject("ROOT_PUBLIC_KEY");
+  }
+
+  if (!root_not_after.has_value() || *root_not_after <= 0 ||
+      *root_not_after > kMaxUnixSeconds) {
+    return reject("ROOT_NOT_AFTER");
+  }
+
+  if (!capability_flags.has_value() || *capability_flags != 0) {
+    return reject("CAPABILITY_FLAGS");
+  }
+
+  ServiceId service_id{};
+  std::copy(service_id_bytes->begin(),
+            service_id_bytes->end(),
+            service_id.begin());
+
+  Ed25519PublicKey root_public_key{};
+  std::copy(root_public_key_bytes->begin(),
+            root_public_key_bytes->end(),
+            root_public_key.begin());
+
+  const base::Time now = base::Time::Now();
+  const base::Time root_expiry =
+      base::Time::UnixEpoch() + base::Seconds(*root_not_after);
+
+  if (!store->InstallDnssecBootstrap(
+          hostname,
+          network_anonymization_key,
+          service_id,
+          static_cast<uint64_t>(*root_epoch),
+          std::vector<uint8_t>(
+              admission_context->begin(),
+              admission_context->end()),
+          root_public_key,
+          root_expiry,
+          now,
+          base::TimeTicks::Now())) {
+    return reject("STATE_INSTALL");
+  }
+
+  LOG(ERROR) << "DNS_FRESHNESS_NATIVE DISCOVERY_BOOTSTRAP=PASS"
+             << " HOST=" << hostname
+             << " ROOT_EPOCH=" << *root_epoch;
+  return true;
+}
+
+}  // namespace network::freshness

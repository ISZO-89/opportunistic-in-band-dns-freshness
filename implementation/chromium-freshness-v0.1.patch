+
+}  // namespace object_label
+
+// Delta-operation map labels.
+namespace operation_label {
+
+constexpr uint64_t kOperation = 0;
+constexpr uint64_t kOwner = 1;
+constexpr uint64_t kType = 2;
+constexpr uint64_t kClass = 3;
+constexpr uint64_t kTtl = 4;
+constexpr uint64_t kRdata = 5;

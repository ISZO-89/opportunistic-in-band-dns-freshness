+constexpr uint64_t kToGeneration = 12;
+constexpr uint64_t kToDigest = 13;
+constexpr uint64_t kOperations = 14;
+
+// Full-stack extensions.
+constexpr uint64_t kAdmissionContext = 15;
+constexpr uint64_t kMembers = 16;
+constexpr uint64_t kCompleteScopeState = 17;
+
+constexpr uint64_t kReason = 18;
+constexpr uint64_t kHeadGeneration = 19;
+constexpr uint64_t kHeadDigest = 20;
+
+constexpr uint64_t kAuthorizedKeyId = 21;

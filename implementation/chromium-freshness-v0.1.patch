+void HostResolverManager::ServiceEndpointRequestImpl::
+    NotifyNetworkDelegateOfEndpointMetadata() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_ENTER"
+             << " host=" << host_.GetHostnameWithoutBrackets();
+
+  if (!resolve_context_) {
+    LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_STOP=NO_RESOLVE_CONTEXT";
+    return;
+  }
+
+  if (!resolve_context_->url_request_context()) {
+    LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_STOP=NO_URL_REQUEST_CONTEXT";
+    return;
+  }
+
+  NetworkDelegate* network_delegate =
+      resolve_context_->url_request_context()->network_delegate();
+  if (!network_delegate) {
+    LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_STOP=NO_NETWORK_DELEGATE";
+    return;
+  }
+
+  auto endpoints = GetEndpointResults();
+
+  LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_ENDPOINTS"
+             << " count=" << endpoints.size();
+
+  std::vector<ConnectionEndpointMetadata> metadatas;
+  for (const ServiceEndpoint& endpoint : endpoints) {
+    LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_ENDPOINT"
+               << " target=" << endpoint.metadata.target_name
+               << " freshness_bytes="
+               << endpoint.metadata.dns_freshness_discovery.size()
+               << " default_metadata="
+               << (endpoint.metadata == ConnectionEndpointMetadata());
+
+    if (endpoint.metadata != ConnectionEndpointMetadata()) {
+      metadatas.push_back(endpoint.metadata);
+    }
+  }
+
+  if (metadatas.empty()) {
+    LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_STOP=NO_METADATA";
+    return;
+  }
+
+  LOG(ERROR) << "DNS_FRESHNESS_NATIVE NOTIFY_FORWARD"
+             << " count=" << metadatas.size();
+
+  network_delegate->NotifyResolvedConnectionEndpointMetadata(
+      std::string(host_.GetHostnameWithoutBrackets()),
+      network_anonymization_key_,
+      metadatas);
+}

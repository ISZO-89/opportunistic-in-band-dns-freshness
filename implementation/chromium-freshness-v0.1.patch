+      return;
+    }
+  }
+
+  if (!discovery) {
+    return;
+  }
+
+  freshness::ProcessDnssecFreshnessDiscovery(
+      hostname,
+      network_anonymization_key,
+      *discovery,
+      network_context_->freshness_state_store());
+}

@@ -0,0 +1,197 @@
+// Copyright 2026
+// Opportunistic DNS Freshness research prototype.
+
+#include "services/network/freshness/freshness_cursor.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "services/network/freshness/freshness_wire_profile.h"
+
+namespace network::freshness {
+
+namespace {
+
+void AppendTypeAndLength(std::vector<uint8_t>* out,
+                         uint8_t major_type,
+                         uint64_t value) {
+  if (value < 24) {
+    out->push_back(
+        static_cast<uint8_t>((major_type << 5) | value));
+    return;
+  }
+
+  if (value <= 0xff) {
+    out->push_back(
+        static_cast<uint8_t>((major_type << 5) | 24));
+    out->push_back(static_cast<uint8_t>(value));
+    return;
+  }
+
+  if (value <= 0xffff) {
+    out->push_back(
+        static_cast<uint8_t>((major_type << 5) | 25));
+    out->push_back(static_cast<uint8_t>(value >> 8));
+    out->push_back(static_cast<uint8_t>(value));
+    return;
+  }
+
+  if (value <= 0xffffffffULL) {
+    out->push_back(
+        static_cast<uint8_t>((major_type << 5) | 26));
+
+    for (int shift = 24; shift >= 0; shift -= 8) {
+      out->push_back(
+          static_cast<uint8_t>(value >> shift));
+    }
+
+    return;
+  }
+
+  out->push_back(
+      static_cast<uint8_t>((major_type << 5) | 27));
+
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    out->push_back(
+        static_cast<uint8_t>(value >> shift));
+  }
+}
+
+void AppendUnsigned(std::vector<uint8_t>* out, uint64_t value) {
+  AppendTypeAndLength(out, 0, value);
+}
+
+void AppendArrayHeader(std::vector<uint8_t>* out, uint64_t count) {
+  AppendTypeAndLength(out, 4, count);
+}
+
+void AppendMapHeader(std::vector<uint8_t>* out, uint64_t count) {
+  AppendTypeAndLength(out, 5, count);
+}
+
+template <size_t N>
+void AppendByteArray(std::vector<uint8_t>* out,
+                     const std::array<uint8_t, N>& bytes) {
+  AppendTypeAndLength(out, 2, N);
+  out->insert(out->end(), bytes.begin(), bytes.end());
+}
+
+bool ScopePointerLess(const ScopeState* a, const ScopeState* b) {
+  if (!a || !b) {
+    return a < b;
+  }
+
+  if (a->scope_id != b->scope_id) {
+    return a->scope_id < b->scope_id;
+  }
+
+  if (a->generation != b->generation) {
+    return a->generation < b->generation;
+  }
+
+  return a->state_digest < b->state_digest;
+}
+
+}  // namespace
+
+std::optional<std::string> BuildFreshnessRequestField(
+    const ServiceState& service,
+    std::vector<const ScopeState*> scopes) {
+  if (scopes.size() > wire::kMaxCursorScopes) {
+    return std::nullopt;
+  }
+
+  for (const ScopeState* scope : scopes) {
+    if (!scope) {
+      return std::nullopt;
+    }
+  }
+
+  // Deterministic ordering must not depend on insertion/LRU order.
+  std::sort(
+      scopes.begin(),
+      scopes.end(),
+      ScopePointerLess);
+
+  std::vector<uint8_t> cbor;
+
+  // {
+  //   0: version,
+  //   1: service_id,
+  //   2: [
+  //        {
+  //          0: root_epoch,
+  //          1: scope_id,
+  //          2: generation,
+  //          3: state_digest,
+  //          4: client_max_object_size
+  //        },
+  //        ...
+  //      ]
+  // }
+  AppendMapHeader(&cbor, 3);
+
+  AppendUnsigned(&cbor, wire::cursor_label::kVersion);
+  AppendUnsigned(&cbor, wire::kProtocolVersion);
+
+  AppendUnsigned(&cbor, wire::cursor_label::kServiceId);
+  AppendByteArray(&cbor, service.service_id);
+
+  AppendUnsigned(&cbor, wire::cursor_label::kScopes);
+  AppendArrayHeader(&cbor, scopes.size());
+
+  for (const ScopeState* scope : scopes) {
+    AppendMapHeader(&cbor, 5);
+
+    AppendUnsigned(
+        &cbor,
+        wire::cursor_label::scope::kRootEpoch);
+    AppendUnsigned(&cbor, service.root_epoch);
+
+    AppendUnsigned(
+        &cbor,
+        wire::cursor_label::scope::kScopeId);
+    AppendByteArray(&cbor, scope->scope_id);
+
+    AppendUnsigned(
+        &cbor,
+        wire::cursor_label::scope::kGeneration);
+    AppendUnsigned(&cbor, scope->generation);
+
+    AppendUnsigned(
+        &cbor,
+        wire::cursor_label::scope::kStateDigest);
+    AppendByteArray(&cbor, scope->state_digest);
+
+    AppendUnsigned(
+        &cbor,
+        wire::cursor_label::scope::kClientMaxObjectSize);
+    AppendUnsigned(&cbor, wire::kMaxCoseBytes);
+  }
+
+  if (cbor.size() > wire::kMaxCursorCborBytes) {
+    return std::nullopt;
+  }
+
+  std::string structured_field;
+  structured_field.reserve(
+      2 + ((cbor.size() + 2) / 3) * 4);
+
+  structured_field.push_back(':');
+  structured_field.append(base::Base64Encode(cbor));
+  structured_field.push_back(':');
+
+  if (structured_field.size() >
+      wire::kMaxCursorStructuredFieldBytes) {
+    return std::nullopt;
+  }
+
+  return structured_field;
+}
+
+}  // namespace network::freshness

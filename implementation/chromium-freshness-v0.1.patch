+// Copyright 2026
+// Opportunistic DNS Freshness research prototype.
+
+#include "services/network/freshness/freshness_state_store.h"
+
+#include <algorithm>
+#include <utility>
+
+namespace network::freshness {
+
+bool ScopeState::IsAuthorizedAt(base::Time now) const {
+  return lifecycle == LifecycleState::kActiveAuthorized &&
+         !issued_at.is_null() &&
+         !valid_until.is_null() &&
+         valid_until > issued_at &&
+         now < valid_until;
+}
+
+bool OperationalKeyState::IsValidAt(
+    base::Time now,
+    uint64_t current_root_epoch) const {
+  return root_epoch == current_root_epoch &&
+         !not_before.is_null() &&
+         !not_after.is_null() &&
+         not_after > not_before &&
+         now >= not_before &&
+         now < not_after;
+}
+
+bool ServiceState::IsRootAuthorizedAt(base::Time now) const {
+  return has_root_public_key &&
+         !root_not_after.is_null() &&
+         !now.is_null() &&
+         now < root_not_after;
+}
+
+FreshnessStateStore::FreshnessStateStore() = default;
+FreshnessStateStore::~FreshnessStateStore() = default;
+
+bool FreshnessStateStore::SameServiceKey(
+    const ServiceState& service,
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key) {
+  return service.hostname == hostname &&
+         service.network_anonymization_key == network_anonymization_key;
+}
+
+ServiceState* FreshnessStateStore::FindService(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key) {
+  auto it = std::find_if(
+      services_.begin(), services_.end(),
+      [&](const ServiceState& service) {
+        return SameServiceKey(
+            service, hostname, network_anonymization_key);
+      });
+
+  return it == services_.end() ? nullptr : &*it;
+}
+
+const ServiceState* FreshnessStateStore::FindService(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key) const {
+  auto it = std::find_if(
+      services_.begin(), services_.end(),
+      [&](const ServiceState& service) {
+        return SameServiceKey(
+            service, hostname, network_anonymization_key);
+      });
+
+  return it == services_.end() ? nullptr : &*it;
+}
+
+ScopeState* FreshnessStateStore::FindScope(
+    ServiceState& service,
+    const ScopeId& scope_id) {
+  auto it = std::find_if(
+      service.scopes.begin(), service.scopes.end(),
+      [&](const ScopeState& scope) {
+        return scope.scope_id == scope_id;
+      });
+
+  return it == service.scopes.end() ? nullptr : &*it;
+}
+
+const ScopeState* FreshnessStateStore::FindScope(
+    const ServiceState& service,
+    const ScopeId& scope_id) const {
+  auto it = std::find_if(
+      service.scopes.begin(), service.scopes.end(),
+      [&](const ScopeState& scope) {
+        return scope.scope_id == scope_id;
+      });
+
+  return it == service.scopes.end() ? nullptr : &*it;
+}
+
+bool FreshnessStateStore::ScopeWithinBounds(const ScopeState& scope) {
+  if (scope.members.size() > kMaxMembersPerScope) {
+    return false;
+  }
+
+  for (const MemberState& member : scope.members) {
+    if (member.owner_wire.empty() || member.owner_wire.size() > 255) {
+      return false;
+    }
+
+    if (member.rdata.size() > kMaxRdataPerMember) {
+      return false;
+    }
+
+    if (member.kind != MemberStateKind::kPositive &&
+        !member.rdata.empty()) {
+      return false;
+    }
+
+    for (const std::vector<uint8_t>& rdata : member.rdata) {
+      if (rdata.size() > kMaxSingleRdataBytes) {
+        return false;
+      }
+    }
+  }
+
+  return true;
+}
+
+bool FreshnessStateStore::OperationalKeyWithinBounds(
+    const OperationalKeyState& key) {
+  return !key.key_id.empty() &&
+         key.key_id.size() <= 64 &&
+         !key.not_before.is_null() &&
+         !key.not_after.is_null() &&
+         key.not_after > key.not_before;
+}
+
+void FreshnessStateStore::EvictLeastRecentlyUsedService() {
+  if (services_.empty()) {
+    return;
+  }
+
+  auto it = std::min_element(
+      services_.begin(), services_.end(),
+      [](const ServiceState& a, const ServiceState& b) {
+        return a.last_used < b.last_used;
+      });
+
+  services_.erase(it);
+}
+
+void FreshnessStateStore::EvictLeastRecentlyUsedScope(
+    ServiceState* service) {
+  if (!service || service->scopes.empty()) {
+    return;
+  }
+
+  auto it = std::min_element(
+      service->scopes.begin(), service->scopes.end(),
+      [](const ScopeState& a, const ScopeState& b) {
+        return a.last_used < b.last_used;
+      });
+
+  service->scopes.erase(it);
+}
+
+bool FreshnessStateStore::InstallDnssecBootstrap(
+    std::string hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    const ServiceId& service_id,
+    uint64_t root_epoch,
+    std::vector<uint8_t> admission_context,
+    const Ed25519PublicKey& root_public_key,
+    base::Time root_not_after,
+    base::Time now,
+    base::TimeTicks now_ticks) {
+  if (hostname.empty() ||
+      admission_context.empty() ||
+      admission_context.size() > kMaxAdmissionContextBytes ||
+      root_not_after.is_null() ||
+      now.is_null() ||
+      root_not_after <= now) {
+    return false;
+  }
+
+  ServiceState* existing =
+      FindService(hostname, network_anonymization_key);
+
+  if (!existing) {
+    if (services_.size() >= kMaxFreshnessServices) {
+      EvictLeastRecentlyUsedService();
+    }
+
+    ServiceState service;
+    service.hostname = std::move(hostname);
+    service.network_anonymization_key = network_anonymization_key;
+    service.service_id = service_id;
+    service.root_epoch = root_epoch;
+    service.admission_context = std::move(admission_context);
+    service.root_public_key = root_public_key;
+    service.has_root_public_key = true;
+    service.root_not_after = root_not_after;
+    service.lifecycle = LifecycleState::kDnsBootstrap;
+    service.last_used = now_ticks;
+
+    services_.push_back(std::move(service));
+    return true;
+  }
+
+  if (root_epoch < existing->root_epoch) {
+    return false;
+  }
+
+  const bool trust_or_view_changed =
+      root_epoch > existing->root_epoch ||
+      existing->service_id != service_id ||
+      existing->admission_context != admission_context ||
+      existing->root_public_key != root_public_key;
+
+  if (trust_or_view_changed) {
+    // DNSSEC-authenticated view/root change invalidates old Freshness state.
+    existing->scopes.clear();
+    existing->operational_keys.clear();
+  }
+
+  existing->service_id = service_id;
+  existing->root_epoch = root_epoch;
+  existing->admission_context = std::move(admission_context);
+  existing->root_public_key = root_public_key;
+  existing->has_root_public_key = true;
+  existing->root_not_after = root_not_after;
+  existing->last_used = now_ticks;
+
+  if (existing->scopes.empty()) {
+    // DNSSEC has just re-established current discovery/trust state.
+    // An empty Freshness cursor may now request first/re-admission Snapshot.
+    existing->lifecycle = LifecycleState::kDnsBootstrap;
+  }
+
+  return true;
+}
+
+bool FreshnessStateStore::InstallOperationalKey(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    OperationalKeyState key,
+    base::Time now) {
+  ServiceState* service =
+      FindService(hostname, network_anonymization_key);
+
+  if (!service ||
+      !service->IsRootAuthorizedAt(now) ||
+      !OperationalKeyWithinBounds(key) ||
+      key.root_epoch != service->root_epoch ||
+      !key.IsValidAt(now, service->root_epoch)) {
+    return false;
+  }
+
+  auto it = std::find_if(
+      service->operational_keys.begin(),
+      service->operational_keys.end(),
+      [&](const OperationalKeyState& existing) {
+        return existing.key_id == key.key_id;
+      });
+
+  if (it != service->operational_keys.end()) {
+    *it = std::move(key);
+    return true;
+  }
+
+  if (service->operational_keys.size() >=
+      kMaxOperationalKeysPerService) {
+    return false;
+  }
+
+  service->operational_keys.push_back(std::move(key));
+  return true;
+}
+
+bool FreshnessStateStore::CommitAuthorizedScope(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    ScopeState scope,
+    base::Time now,
+    base::TimeTicks now_ticks) {
+  ServiceState* service =
+      FindService(hostname, network_anonymization_key);
+
+  if (!service ||
+      !ScopeWithinBounds(scope) ||
+      scope.issued_at.is_null() ||
+      scope.valid_until.is_null() ||
+      scope.valid_until <= scope.issued_at ||
+      now >= scope.valid_until) {
+    return false;
+  }
+
+  scope.lifecycle = LifecycleState::kActiveAuthorized;
+  scope.last_used = now_ticks;
+
+  ScopeState* existing = FindScope(*service, scope.scope_id);
+
+  if (existing) {
+    *existing = std::move(scope);
+  } else {
+    if (service->scopes.size() >= kMaxScopesPerService) {
+      // Capacity eviction explicitly terminates update interest.
+      EvictLeastRecentlyUsedScope(service);
+    }
+
+    service->scopes.push_back(std::move(scope));
+  }
+
+  service->lifecycle = LifecycleState::kActiveAuthorized;
+  service->last_used = now_ticks;
+
+  return true;
+}
+
+bool FreshnessStateStore::MarkRecoveryRequired(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    const ScopeId& scope_id) {
+  ServiceState* service =
+      FindService(hostname, network_anonymization_key);
+
+  if (!service) {
+    return false;
+  }
+
+  ScopeState* scope = FindScope(*service, scope_id);
+
+  if (!scope || scope->lifecycle == LifecycleState::kInactive) {
+    return false;
+  }
+
+  scope->lifecycle = LifecycleState::kRecoveryRequired;
+  service->lifecycle = LifecycleState::kRecoveryRequired;
+
+  return true;
+}
+
+bool FreshnessStateStore::EvictScope(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    const ScopeId& scope_id) {
+  ServiceState* service =
+      FindService(hostname, network_anonymization_key);
+
+  if (!service) {
+    return false;
+  }
+
+  auto it = std::find_if(
+      service->scopes.begin(), service->scopes.end(),
+      [&](const ScopeState& scope) {
+        return scope.scope_id == scope_id;
+      });
+
+  if (it == service->scopes.end()) {
+    return false;
+  }
+
+  service->scopes.erase(it);
+
+  if (service->scopes.empty()) {
+    service->lifecycle = LifecycleState::kActiveUnassured;
+  }
+
+  return true;
+}
+
+bool FreshnessStateStore::EvictService(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key) {
+  auto it = std::find_if(
+      services_.begin(), services_.end(),
+      [&](const ServiceState& service) {
+        return SameServiceKey(
+            service, hostname, network_anonymization_key);
+      });
+
+  if (it == services_.end()) {
+    return false;
+  }
+
+  services_.erase(it);
+  return true;
+}
+
+std::vector<const ScopeState*>
+FreshnessStateStore::ActiveScopesForRequest(
+    std::string_view hostname,
+    const net::NetworkAnonymizationKey& network_anonymization_key,
+    base::Time now,
+    base::TimeTicks now_ticks) {
+  std::vector<const ScopeState*> result;
+
+  ServiceState* service =
+      FindService(hostname, network_anonymization_key);
+
+  if (!service || !service->IsRootAuthorizedAt(now)) {
+    return result;
+  }
+
+  service->last_used = now_ticks;
+
+  for (ScopeState& scope : service->scopes) {
+    if (!scope.IsAuthorizedAt(now)) {
+      continue;
+    }
+
+    scope.last_used = now_ticks;
+    result.push_back(&scope);
+  }
+
+  return result;
+}
+
+void FreshnessStateStore::ExpireLeases(base::Time now) {
+  for (ServiceState& service : services_) {
+    if (service.has_root_public_key &&
+        !service.IsRootAuthorizedAt(now)) {
+      service.scopes.clear();
+      service.operational_keys.clear();
+      service.lifecycle = LifecycleState::kActiveUnassured;
+      continue;
+    }
+
+    bool any_authorized = false;
+
+    for (ScopeState& scope : service.scopes) {
+      if (scope.lifecycle == LifecycleState::kActiveAuthorized &&
+          !scope.IsAuthorizedAt(now)) {
+        scope.lifecycle = LifecycleState::kActiveUnassured;
+      }
+
+      if (scope.IsAuthorizedAt(now)) {
+        any_authorized = true;
+      }
+    }
+
+    if (!any_authorized &&
+        service.lifecycle == LifecycleState::kActiveAuthorized) {
+      service.lifecycle = LifecycleState::kActiveUnassured;
+    }
+  }
+}
+
+void FreshnessStateStore::Clear() {
+  services_.clear();
+}
+
+}  // namespace network::freshness

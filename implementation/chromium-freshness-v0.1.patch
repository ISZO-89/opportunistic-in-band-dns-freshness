+// Copyright 2026
+// Opportunistic DNS Freshness research prototype.
+
+#ifndef SERVICES_NETWORK_FRESHNESS_FRESHNESS_STATE_STORE_H_
+#define SERVICES_NETWORK_FRESHNESS_FRESHNESS_STATE_STORE_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/time/time.h"
+#include "net/base/network_anonymization_key.h"
+
+namespace network::freshness {
+
+constexpr size_t kFreshnessServiceIdBytes = 16;
+constexpr size_t kFreshnessScopeIdBytes = 16;
+constexpr size_t kFreshnessDigestBytes = 32;
+constexpr size_t kFreshnessEd25519PublicKeyBytes = 32;
+
+constexpr size_t kMaxFreshnessServices = 64;
+constexpr size_t kMaxScopesPerService = 32;
+constexpr size_t kMaxMembersPerScope = 64;
+constexpr size_t kMaxRdataPerMember = 32;
+constexpr size_t kMaxSingleRdataBytes = 4096;
+constexpr size_t kMaxAdmissionContextBytes = 256;
+constexpr size_t kMaxOperationalKeysPerService = 8;
+
+using ServiceId = std::array<uint8_t, kFreshnessServiceIdBytes>;
+using ScopeId = std::array<uint8_t, kFreshnessScopeIdBytes>;
+using StateDigest = std::array<uint8_t, kFreshnessDigestBytes>;
+using Ed25519PublicKey =
+    std::array<uint8_t, kFreshnessEd25519PublicKeyBytes>;
+
+enum class LifecycleState {
+  kInactive,
+  kDnsBootstrap,
+  kActiveUnassured,
+  kActiveAuthorized,
+  kRecoveryRequired,
+};
+
+enum class MemberStateKind {
+  kPositive,
+  kNoData,
+  kNxDomain,
+};
+
+// Explicit immutable scope member.
+//
+// The member identity is owner/type/class.
+// `kind` describes its current DNS state.
+//
+// POSITIVE:
+//   ttl + rdata[] carry current RRset.
+//
+// NODATA / NXDOMAIN:
+//   ttl is the signed negative-cache lifetime and rdata[] is empty.
+struct MemberState {
+  std::vector<uint8_t> owner_wire;
+  uint16_t rrtype = 0;
+  uint16_t rrclass = 0;
+
+  MemberStateKind kind = MemberStateKind::kPositive;
+
+  uint32_t ttl = 0;
+  std::vector<std::vector<uint8_t>> rdata;
+
+  bool operator==(const MemberState&) const = default;
+};
+
+struct ScopeState {
+  ScopeId scope_id{};
+
+  uint64_t generation = 0;
+  StateDigest state_digest{};
+
+  base::Time issued_at;
+  base::Time valid_until;
+
+  LifecycleState lifecycle = LifecycleState::kInactive;
+
+  // Complete CURRENT state only.
+  // Client-side historical generations are intentionally not retained.
+  std::vector<MemberState> members;
+
+  base::TimeTicks last_used;
+
+  bool IsAuthorizedAt(base::Time now) const;
+};
+
+struct OperationalKeyState {
+  std::vector<uint8_t> key_id;
+  Ed25519PublicKey public_key{};
+
+  uint64_t root_epoch = 0;
+
+  base::Time not_before;
+  base::Time not_after;
+
+  bool IsValidAt(base::Time now, uint64_t current_root_epoch) const;
+};
+
+// DNSSEC-authenticated service/view state for one NAK partition.
+//
+// Multiple Freshness scopes may belong to one service.
+struct ServiceState {
+  std::string hostname;
+  net::NetworkAnonymizationKey network_anonymization_key;
+
+  ServiceId service_id{};
+
+  uint64_t root_epoch = 0;
+
+  // Opaque DNSSEC-authenticated view binding.
+  std::vector<uint8_t> admission_context;
+
+  Ed25519PublicKey root_public_key{};
+  bool has_root_public_key = false;
+
+  // DNSSEC-authenticated expiry of the Freshness root trust anchor.
+  // This is a cryptographic trust bound, not a DNS freshness TTL.
+  base::Time root_not_after;
+
+  bool IsRootAuthorizedAt(base::Time now) const;
+
+  std::vector<OperationalKeyState> operational_keys;
+  std::vector<ScopeState> scopes;
+
+  LifecycleState lifecycle = LifecycleState::kInactive;
+
+  base::TimeTicks last_used;
+};
+
+// Per-NetworkContext bounded Freshness state.
+//
+// State is partitioned by NetworkAnonymizationKey.
+// Eviction deletes active interest: a later generation jump after eviction is
+// therefore fresh admission, not a missed-update fault.
+class FreshnessStateStore {
+ public:
+  FreshnessStateStore();
+  ~FreshnessStateStore();
+
+  FreshnessStateStore(const FreshnessStateStore&) = delete;
+  FreshnessStateStore& operator=(const FreshnessStateStore&) = delete;
+
+  ServiceState* FindService(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key);
+
+  const ServiceState* FindService(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key) const;
+
+  ScopeState* FindScope(ServiceState& service, const ScopeId& scope_id);
+  const ScopeState* FindScope(const ServiceState& service,
+                              const ScopeId& scope_id) const;
+
+  // Installs DNSSEC-authenticated discovery/root material.
+  //
+  // Higher root_epoch or changed admission_context invalidates old scoped
+  // Freshness state. Lower root_epoch is rejected.
+  bool InstallDnssecBootstrap(
+      std::string hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      const ServiceId& service_id,
+      uint64_t root_epoch,
+      std::vector<uint8_t> admission_context,
+      const Ed25519PublicKey& root_public_key,
+      base::Time root_not_after,
+      base::Time now,
+      base::TimeTicks now_ticks);
+
+  bool InstallOperationalKey(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      OperationalKeyState key,
+      base::Time now);
+
+  // Snapshot admission or fully validated replacement.
+  bool CommitAuthorizedScope(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      ScopeState scope,
+      base::Time now,
+      base::TimeTicks now_ticks);
+
+  bool MarkRecoveryRequired(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      const ScopeId& scope_id);
+
+  bool EvictScope(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      const ScopeId& scope_id);
+
+  bool EvictService(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key);
+
+  std::vector<const ScopeState*> ActiveScopesForRequest(
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key,
+      base::Time now,
+      base::TimeTicks now_ticks);
+
+  void ExpireLeases(base::Time now);
+  void Clear();
+
+  size_t service_count() const { return services_.size(); }
+
+ private:
+  static bool SameServiceKey(
+      const ServiceState& service,
+      std::string_view hostname,
+      const net::NetworkAnonymizationKey& network_anonymization_key);
+
+  static bool ScopeWithinBounds(const ScopeState& scope);
+  static bool OperationalKeyWithinBounds(const OperationalKeyState& key);
+
+  void EvictLeastRecentlyUsedService();
+  static void EvictLeastRecentlyUsedScope(ServiceState* service);
+
+  std::vector<ServiceState> services_;
+};
+
+}  // namespace network::freshness
+
+#endif  // SERVICES_NETWORK_FRESHNESS_FRESHNESS_STATE_STORE_H_

+std::optional<std::string> BuildFreshnessCursorForRequest(
+    NetworkContext* network_context,
+    net::URLRequest* request) {
+  if (!network_context || !request || !request->url().SchemeIs("https")) {
+    return std::nullopt;
+  }
+
+  freshness::FreshnessStateStore* store =
+      network_context->freshness_state_store();
+
+  const base::Time now = base::Time::Now();
+  const base::TimeTicks now_ticks = base::TimeTicks::Now();
+
+  // Expired authorization must stop opportunistic Freshness before deciding
+  // whether this natural application request may carry a cursor.
+  store->ExpireLeases(now);
+
+  const auto hostname = request->url().host();
+  const net::NetworkAnonymizationKey& nak =
+      request->isolation_info().network_anonymization_key();
+
+  freshness::ServiceState* service = store->FindService(hostname, nak);
+  if (!service) {
+    return std::nullopt;
+  }
+
+  switch (service->lifecycle) {
+    case freshness::LifecycleState::kDnsBootstrap:
+      // DNSSEC has authenticated service/root/view state, but no scope has
+      // yet been admitted. An empty cursor permits Snapshot admission on this
+      // natural application request.
+      return freshness::BuildFreshnessRequestField(*service, {});
+
+    case freshness::LifecycleState::kActiveAuthorized: {
+      std::vector<const freshness::ScopeState*> scopes =
+          store->ActiveScopesForRequest(hostname, nak, now, now_ticks);
+      if (scopes.empty()) {
+        return std::nullopt;
+      }
+
+      return freshness::BuildFreshnessRequestField(
+          *service, std::move(scopes));
+    }
+
+    case freshness::LifecycleState::kInactive:
+    case freshness::LifecycleState::kActiveUnassured:
+    case freshness::LifecycleState::kRecoveryRequired:
+      return std::nullopt;
+  }
+
+  return std::nullopt;
+}

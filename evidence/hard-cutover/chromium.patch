+bool HostCache::UpdateActiveAddressForFreshness(
+    std::string_view hostname,
+    const NetworkAnonymizationKey& network_anonymization_key,
+    const IPAddress& address,
+    base::TimeTicks now,
+    base::TimeDelta ttl) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+
+  if (!address.IsValid() || ttl < base::TimeDelta()) {
+    return false;
+  }
+
+  // Collect replacements first. HostCache::Set() mutates entries_, so it must
+  // not be called while entries_ is being iterated.
+  std::vector<std::pair<Key, Entry>> replacements;
+
+  for (const auto& cache_entry : entries_) {
+    const Key& key = cache_entry.first;
+    const Entry& entry = cache_entry.second;
+
+    if (GetHostname(key.host) != hostname) {
+      continue;
+    }
+
+    if (key.network_anonymization_key != network_anonymization_key) {
+      continue;
+    }
+
+    // Freshness only updates DNS-derived state. HOSTS/config entries are not
+    // rewritten by application-carried DNS state.
+    if (entry.source() != Entry::SOURCE_DNS) {
+      continue;
+    }
+
+    // Evicted entries are absent. Expired/past-network entries are not active
+    // Freshness state and must return to normal resolver policy.
+    if (entry.IsStale(now, network_changes_)) {
+      continue;
+    }
+
+    std::vector<IPEndPoint> endpoints = entry.ip_endpoints();
+    bool replaced = false;
+
+    for (IPEndPoint& endpoint : endpoints) {
+      const bool same_family =
+          (address.IsIPv4() && endpoint.address().IsIPv4()) ||
+          (address.IsIPv6() && endpoint.address().IsIPv6());
+
+      if (!same_family) {
+        continue;
+      }
+
+      endpoint = IPEndPoint(address, endpoint.port());
+      replaced = true;
+    }
+
+    if (!replaced) {
+      continue;
+    }
+
+    Entry replacement(entry);
+    replacement.set_ip_endpoints(std::move(endpoints));
+
+    replacements.emplace_back(key, std::move(replacement));
+  }
+
+  for (const auto& replacement : replacements) {
+    Set(replacement.first, replacement.second, now, ttl);
+  }
+
+  return !replacements.empty();
+}
